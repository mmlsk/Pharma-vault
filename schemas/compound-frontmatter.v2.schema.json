{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mmlsk/Pharma-vault/schemas/compound-frontmatter.v2.schema.json",
  "title": "Pharma-vault compound note frontmatter (schema-version 2)",
  "description": "Validation rules for YAML frontmatter of notes in vault/04 Compound Notes. Empty (null) values are allowed for every curatable field so that stubs validate; controlled vocabularies and numeric bounds apply as soon as a value is entered.",
  "type": "object",
  "required": ["type", "schema-version", "compound-id", "name", "review-status", "tags"],
  "additionalProperties": true,
  "properties": {
    "type": { "const": "compound" },
    "schema-version": { "const": 2 },
    "compound-id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "$ref": "#/$defs/stringList" },
    "cluster": { "$ref": "#/$defs/optString" },
    "group": { "$ref": "#/$defs/optString" },
    "class": { "$ref": "#/$defs/optString" },
    "subclass": { "$ref": "#/$defs/optString" },
    "mechanism": { "$ref": "#/$defs/optString" },
    "pathways": { "$ref": "#/$defs/stringList" },
    "indications": { "$ref": "#/$defs/stringList" },
    "off-label-contexts": { "$ref": "#/$defs/stringList" },
    "regulatory-status": {
      "enum": [null, "approved", "prescription-only", "otc", "supplement", "investigational",
               "research-chemical", "controlled", "banned", "withdrawn", "unknown"]
    },
    "evidence-level": {
      "description": "Formal evidence tier. Vendor presence must never upgrade evidence.",
      "enum": [null, "A-approved", "B-human-controlled", "C-early-human", "D-preclinical",
               "E-forensic-NPS", "F-vendor-only", "X-identity-disputed"]
    },
    "review-status": { "enum": ["stub", "candidate", "expanded", "verified", "needs-update"] },
    "status": { "$ref": "#/$defs/optString" },
    "chembl-id": { "type": ["string", "null"], "pattern": "^CHEMBL[0-9]+$" },
    "chembl-max-phase": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
    "half-life": {
      "type": ["object", "null"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "enum": [null, "min", "h", "d", "wk"] },
        "notes": { "$ref": "#/$defs/optString" }
      }
    },
    "protein-binding": {
      "type": ["object", "null"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "unit": { "enum": [null, "percent"] },
        "notes": { "$ref": "#/$defs/optString" }
      }
    },
    "active-metabolites": { "$ref": "#/$defs/stringList" },
    "renal-clearance": {
      "type": ["object", "null"],
      "properties": {
        "primary-route": { "type": ["boolean", "null"] },
        "fraction-excreted-unchanged": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "notes": { "$ref": "#/$defs/optString" }
      }
    },
    "hepatic-clearance": {
      "type": ["object", "null"],
      "properties": {
        "primary-route": { "type": ["boolean", "null"] },
        "extraction-ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "notes": { "$ref": "#/$defs/optString" }
      }
    },
    "dosage-ranges": {
      "description": "Reference ranges from authoritative labelling only. Educational use; not dosing advice.",
      "type": ["object", "null"],
      "properties": {
        "oral": { "$ref": "#/$defs/routeDose" },
        "injectable": { "$ref": "#/$defs/routeDose" },
        "topical": { "$ref": "#/$defs/routeDose" }
      },
      "additionalProperties": { "$ref": "#/$defs/routeDose" }
    },
    "cyp-interactions": {
      "type": ["object", "null"],
      "properties": {
        "substrates": { "$ref": "#/$defs/cypList" },
        "inhibitors": { "$ref": "#/$defs/cypList" },
        "inducers": { "$ref": "#/$defs/cypList" },
        "transporters": { "$ref": "#/$defs/stringList" },
        "notes": { "$ref": "#/$defs/optString" }
      }
    },
    "contraindications": { "$ref": "#/$defs/stringList" },
    "major-interactions": { "$ref": "#/$defs/stringList" },
    "monitoring": { "$ref": "#/$defs/stringList" },
    "risk-domains": { "$ref": "#/$defs/stringList" },
    "group-risk-triage": { "$ref": "#/$defs/stringList" },
    "source-status": { "enum": [null, "source-summary-only", "partially-verified", "verified"] },
    "last-reviewed": { "type": ["string", "null"], "format": "date" },
    "tags": { "type": "array", "items": { "type": "string" }, "contains": { "const": "compound" } }
  },
  "$defs": {
    "optString": { "type": ["string", "null"] },
    "stringList": { "type": ["array", "null"], "items": { "type": "string" } },
    "cypList": {
      "type": ["array", "null"],
      "items": { "type": "string", "pattern": "^CYP[0-9]{1,2}[A-Z][0-9]{1,2}$" }
    },
    "routeDose": {
      "type": ["object", "null"],
      "properties": {
        "min": { "type": ["number", "null"], "minimum": 0 },
        "max": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "$ref": "#/$defs/optString" },
        "frequency": { "$ref": "#/$defs/optString" },
        "notes": { "$ref": "#/$defs/optString" }
      }
    }
  }
}
